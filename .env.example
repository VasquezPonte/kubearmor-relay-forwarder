RELAY_ADDR=kubearmor.kubearmor.svc.cluster.local:32767
API_URL=https://custom-api.example.com/v1/security-alerts
WEBHOOK_CUSTOMHEADERS='Authorization:Bearer your-api-key,X-Security-Source:kubearmor'
SOURCE_NAME=kubearmor
SPOOL_DIR=/var/lib/kubearmor-forwarder/spool
MAX_SPOOL_EVENTS=20000
CUSTOM_FIELDS_JSON='{"key1":"value1","key2":"value2"}'
ALLOW_INSECURE_API_HTTP=false
